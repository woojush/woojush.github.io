---
// About의 Timeline. 왼쪽 기간, 오른쪽 제목과 항목을 세로선 한 줄로 잇는다. 점·아이콘 장식 없음 (DESIGN.md §6).
// 데이터는 src/data/timeline.yaml. 이 컴포넌트는 받아서 그리기만 한다.
interface Entry {
  period: string;
  title: string;
  items?: string[];
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ol class="timeline">
  {
    entries.map((entry) => (
      <li class="entry">
        <span class="period">{entry.period}</span>
        <div class="body">
          <p class="title">{entry.title}</p>
          {entry.items && entry.items.length > 0 && <p class="items">{entry.items.join(', ')}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
  }

  .period {
    padding-block: var(--space-3);
    color: var(--text-muted);
    font-size: var(--fs-s);
    line-height: var(--lh-base);
    font-variant-numeric: tabular-nums;
  }

  /* 세로선은 body의 왼쪽 테두리. 칸 사이에 간격을 두지 않고 padding으로만 띄워 선이 끊기지 않는다 */
  .body {
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border-left: 1px solid var(--rule);
  }

  .title,
  .items {
    margin: 0;
  }

  .items {
    color: var(--text-muted);
    font-size: var(--fs-s);
    line-height: var(--lh-s);
  }
</style>
