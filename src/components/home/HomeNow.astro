---
// 홈의 NOW: 지금 하고 있는 것. 행은 data/now.yaml의 데이터이고, 비어 있으면 그리지 않는다.
interface Props {
  items: readonly { label: string; text: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section aria-labelledby="home-now">
      <h2 id="home-now">Now</h2>
      <dl>
        {items.map((item) => (
          <div class="row">
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  h2 {
    margin-top: var(--space-7);
    font-size: var(--fs-l);
    line-height: var(--lh-l);
  }

  dl {
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px solid var(--rule);
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
  }

  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
