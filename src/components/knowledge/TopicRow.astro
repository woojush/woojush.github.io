---
// 주제 한 줄(분야 또는 세부분야): 큰 이름 | 설명 | 글 수. 카드가 아니라 행이다. 줄 전체가 링크 영역이다.
interface Props {
  href: string;
  name: string;
  count: number;
  description?: string;
  /** 이름 아래 작은 글씨 (예: 안에 든 세부분야 이름들) */
  meta?: string;
}

const { href, name, count, description, meta } = Astro.props;
---

<li class="row">
  <div class="main">
    <a href={href}>{name}</a>
    {description && <p class="desc">{description}</p>}
    {meta && <p class="meta">{meta}</p>}
  </div>
  <span class="count">{count}</span>
</li>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  a {
    color: var(--text);
    font-size: var(--fs-xl);
    font-weight: var(--fw-strong);
    line-height: var(--lh-xl);
    text-decoration: none;
  }

  /* 줄 전체를 누를 수 있게 한다 */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  p {
    margin: var(--space-1) 0 0;
    color: var(--text-muted);
    font-size: var(--fs-s);
    line-height: var(--lh-s);
  }

  .desc {
    font-size: var(--fs-base);
    line-height: var(--lh-m);
  }

  .count {
    color: var(--text-muted);
    font-size: var(--fs-m);
  }
</style>
