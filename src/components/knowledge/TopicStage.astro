---
// 하위 주제들이 별이 떠 있는 어두운 장면 위에서 천천히 떠다니는 태그. 이름 칸과 글 수 칸만 보인다. 누르면 그 주제 페이지로 들어간다.
// 모든 태그는 글 수와 무관하게 같은 크기다. 색은 주제마다 다르다 (topics.yaml의 color, 없으면 부모 색).
// 마크업은 평범한 링크 목록이라 스크립트가 없거나 움직임 줄이기 설정이어도 그대로 쓸 수 있다.
// 떠다니는 동작은 src/scripts/topic-stage.ts. 이 장면은 Knowledge 한정으로 승인된 모션이다(CLAUDE.md §8, docs/07 §3).
import { topicHref, type TopicNode } from '@/lib/topics';

interface Props {
  nodes: readonly TopicNode[];
}

const { nodes } = Astro.props;

// 별: 고정 난수로 점을 흩뿌린 SVG 타일 하나를 마스크로 쓴다 (색은 CSS 토큰이 정한다)
let seed = 7;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
const TILE = 560;
const dots = Array.from({ length: 80 }, () => {
  const r = (0.5 + rnd() * 0.9).toFixed(2);
  const o = (0.35 + rnd() * 0.65).toFixed(2);
  return `<circle cx='${(rnd() * TILE).toFixed(0)}' cy='${(rnd() * TILE).toFixed(0)}' r='${r}' fill='white' fill-opacity='${o}'/>`;
}).join('');
const stars = `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='${TILE}' height='${TILE}'>${dots}</svg>`)}")`;
---

<nav class="stage" aria-label="Topics" data-stage style={`--stars:${stars}`}>
  <ul>
    {
      nodes.map((n, i) => (
        <li style={`--i:${i};--hue:var(--tag-${n.color})`}>
          <a href={topicHref(n.path)}>
            <span class="name">{n.name}</span>
            <span class="count" aria-label={`${n.count}개의 노트`}>{n.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '@/scripts/topic-stage';
</script>

<style>
  .stage {
    position: relative;
    background-color: var(--stage-bg);
    border-radius: var(--radius-s);
  }

  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(var(--star));
    mask-image: var(--stars);
    mask-size: 560px 560px;
    pointer-events: none;
  }

  .stage ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 1.25rem;
    position: relative;
    list-style: none;
    max-width: none;
  }

  /* 태그: 이름 칸(색) + 글 수 칸(어두운 회색). 크기는 모든 태그가 같다 */
  a {
    display: inline-flex;
    align-items: stretch;
    width: 14.5rem;
    max-width: 100%;
    height: 2.75rem;
    color: var(--tag-text);
    font-size: var(--fs-s);
    text-decoration: none;
    transition: filter var(--duration) var(--ease);
  }

  a:hover {
    filter: brightness(1.15);
  }

  .name,
  .count {
    display: flex;
    align-items: center;
    padding: 0 0.9rem;
  }

  .name {
    flex: 1;
    min-width: 0;
    background: var(--hue);
    border-radius: 2px 0 0 2px;
    font-weight: var(--fw-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .count {
    justify-content: center;
    min-width: 3.5rem;
    background: var(--tag-count-bg);
    border-radius: 0 2px 2px 0;
    color: var(--tag-count-text);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }

  /* ── 떠다니는 상태 (스크립트가 .is-floating을 붙인다) ── */
  .stage:global(.is-floating) {
    position: relative;
    height: clamp(22rem, calc(100svh - 24rem), 40rem);
    overflow: hidden;
  }

  .stage:global(.is-floating) ul {
    display: block;
    padding: 0;
  }

  .stage:global(.is-floating) li {
    position: absolute;
    top: 0;
    left: 0;
    will-change: translate;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stage:global(.is-floating) li {
      animation: drift-in var(--duration-slow) var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms);
    }

    .stage:global(.is-floating) li a {
      transition:
        filter var(--duration) var(--ease),
        opacity 320ms var(--ease),
        scale 380ms var(--ease-custom);
    }

    /* 하나를 누르면 나머지는 사라지고, 누른 것은 커지며 사라진다. 그 사이에 다음 페이지로 간다 */
    .stage:global(.is-leaving) li a {
      opacity: 0;
    }

    .stage:global(.is-leaving) li:global(.is-picked) a {
      scale: 1.4;
    }
  }

  @keyframes drift-in {
    from {
      opacity: 0;
    }
  }
</style>
