---
// 주제 트리: 분야(h2) → 세부분야(h3, 접고 펼 수 있음) → 노트 행. 데이터는 lib/topics.ts가 만든 트리를 받아 그리기만 한다.
// 세부분야가 길어지면(OPEN_LIMIT 초과) 처음에는 접어 둔다. 주소의 #앵커가 접힌 곳을 가리키면 펼친다(아래 스크립트).
import EntryRow from '@/components/knowledge/EntryRow.astro';
import type { TopicNode } from '@/lib/topics';

interface Props {
  tree: readonly TopicNode[];
}

const { tree } = Astro.props;
const OPEN_LIMIT = 12;
const href = (id: string) => `/knowledge/${id}/`;
---

{
  tree.map((field) => (
    <section class="field" id={field.anchor} aria-labelledby={`${field.anchor}-h`}>
      <h2 id={`${field.anchor}-h`}>
        {field.name} <span class="count">{field.count}</span>
      </h2>
      {field.notes.length > 0 && (
        <ul>
          {field.notes.map((n) => (
            <EntryRow href={href(n.id)} title={n.data.title} status={n.data.status} date={n.data.updated ?? n.data.date} description={n.data.description} />
          ))}
        </ul>
      )}
      {field.children.map((sub) => (
        <details class="sub" id={sub.anchor} open={sub.count <= OPEN_LIMIT}>
          <summary>
            <h3>{sub.name}</h3>
            <span class="count">{sub.count}</span>
          </summary>
          <ul>
            {sub.notes.map((n) => (
              <EntryRow href={href(n.id)} title={n.data.title} status={n.data.status} date={n.data.updated ?? n.data.date} description={n.data.description} />
            ))}
          </ul>
        </details>
      ))}
    </section>
  ))
}

<script>
  // #topic-… 앵커가 접힌 세부분야를 가리키면 펼친다 (글 페이지의 breadcrumb에서 올 때)
  function openTarget(): void {
    const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  }
  openTarget();
  addEventListener('hashchange', openTarget);
</script>

<style>
  .field {
    margin-top: var(--space-7);
    scroll-margin-top: var(--space-6);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-l);
    line-height: var(--lh-l);
  }

  .count {
    margin-left: var(--space-1);
    color: var(--text-muted);
    font-size: var(--fs-s);
    font-weight: var(--fw-regular);
  }

  ul {
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .sub {
    margin-bottom: var(--space-4);
    scroll-margin-top: var(--space-6);
  }

  summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: var(--tap);
    padding-block: var(--space-1);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* 펼침 표시: 글자 하나(+/−). 움직임 없음 */
  summary::before {
    content: '+';
    width: 1ch;
    color: var(--text-muted);
  }

  .sub[open] > summary::before {
    content: '−';
  }

  h3 {
    margin: 0;
    font-size: var(--fs-m);
    line-height: var(--lh-m);
  }
</style>
