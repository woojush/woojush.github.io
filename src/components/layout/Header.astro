---
// 사이트 헤더: 이름(좌). 탭 바는 데스크톱에서 화면 위 가운데에 떠 있고(nav.css), 모바일에서는 이름 아래 한 줄이다.
// DOM 순서가 곧 Tab 순서다: 이름 → 메뉴. 오른쪽은 비어 있다(테마 토글은 라이트 테마와 함께 없앴다).
import Nav from './Nav.astro';

interface Props {
  name: string;
  items: readonly { label: string; href: string }[];
  currentPath: string;
}

const { name, items, currentPath } = Astro.props;
---

<header class="site-header">
  <div class="page header-inner">
    <a class="site-name" href="/">{name}</a>
    <Nav items={items} currentPath={currentPath} />
  </div>
</header>

<style>
  /* 떠 있는 탭 바(position: fixed)가 본문 위에 오도록 base.css의 z-index: 1보다 높인다 */
  .site-header {
    z-index: 3;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-4);
    min-height: var(--header-h);
    padding-block: var(--space-2);
  }

  /* 이름을 왼쪽에 두고, 나머지(메뉴)를 오른쪽으로 민다 */
  .site-name {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-inline-end: auto;
    color: var(--text);
    font-size: var(--fs-m);
    font-weight: var(--fw-strong);
    line-height: var(--lh-m);
    text-decoration: none;
    /* 흰 세계와 어두운 세계를 오갈 때 글자색이 서서히 바뀐다 */
    transition: color 0.3s var(--ease);
  }

  /* 데스크톱: 이름은 화면 맨 위 맨 왼쪽 모서리에 고정된다 (탭 바와 같은 높이의 줄) */
  @media (min-width: 641px) and (hover: hover) {
    .site-name {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 4;
      height: var(--header-h);
      padding-inline: var(--space-5);
      margin: 0;
    }
  }

  .site-name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
