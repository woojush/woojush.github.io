---
// 주 메뉴(탭 바). 항목은 data/site.ts의 nav를 받아 그리기만 한다. home은 메뉴에 없고, 이름과 가운데 허브가 홈 링크다.
// 모양은 lifestories.org의 상단 알약을 따른다 (docs/07 §3 c).
//   데스크톱(마우스): 화면 위 가운데에 떠 있는 작은 알약 + 가운데 허브. 마우스가 올라가면 늘어나며 글자가 안쪽으로 모인다.
//   그 밖(모바일·터치): 이름 아래 한 줄에 글자가 처음부터 보이는 알약.
// 각각 별도 페이지의 일반 링크다 (ARIA tabs 아님). 정확히 그 페이지는 aria-current="page", 그 섹션의 하위 글은 "true".
import '@/styles/nav.css';

interface Props {
  items: readonly { label: string; href: string }[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

function currentState(href: string): 'page' | 'true' | undefined {
  if (href === currentPath) return 'page';
  if (href !== '/' && currentPath.startsWith(href)) return 'true';
  return undefined;
}

// 가운데 허브를 사이에 두고 항목을 반으로 나눈다. 글자는 바깥쪽에서 안쪽으로 모여든다.
// 왼쪽 묶음은 허브 쪽으로, 오른쪽 묶음은 허브 쪽으로 붙여서 글자 사이·허브와의 간격이 항상 같다.
const half = Math.ceil(items.length / 2);
const shifts = ['-0.875rem', '-0.5rem', '0.5rem', '0.875rem'];
const entries = items.map((item, i) => ({
  ...item,
  state: currentState(item.href),
  shift: shifts[Math.min(i < half ? i : shifts.length - (items.length - i), shifts.length - 1)],
}));
const groups = [entries.slice(0, half), entries.slice(half)];
---

<nav class="nav" aria-label="Main">
  <div class="nav-pill">
    <span class="nav-blob" aria-hidden="true"></span>
    <div class="nav-items">
      {
        groups.map((group, g) => (
          <>
            {g === 1 && <span class="nav-spacer" aria-hidden="true" />}
            <ul class={`nav-list nav-list-${g === 0 ? 'start' : 'end'}`} role="list">
              {group.map((item) => (
                <li>
                  <a class="nav-link" href={item.href} data-label={item.label} aria-current={item.state} style={`--shift:${item.shift}`}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </div>
  </div>
  <a class="nav-hub" href="/" aria-label="Home" aria-current={currentPath === '/' ? 'page' : undefined}>
    <span></span><span></span><span></span><span></span>
  </a>
</nav>

<script>
  import '@/scripts/nav.ts';
</script>
