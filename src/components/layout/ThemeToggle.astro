---
// dark ↔ light 토글. 동작은 src/scripts/theme-toggle.ts, 초기 적용은 theme-init.js.
// 헤더에 두 번 렌더링된다. 같은 버튼을 DOM 위치만 달리해서 두고, 화면 폭(640px)마다 하나만 보이게 해서
// Tab 순서와 화면 순서를 맞춘다.
//   mobile  : 이름 바로 뒤 (이름 → 토글 → 메뉴)   ≤ 640px에서만 보임
//   desktop : 메뉴 뒤      (이름 → 메뉴 → 토글)   ≥ 641px에서만 보임
// display:none인 쪽은 Tab 순서와 접근성 트리에서 빠진다.
interface Props {
  placement: 'mobile' | 'desktop';
}

const { placement } = Astro.props;
---

<button type="button" class="theme-toggle" data-theme-toggle data-placement={placement}>
  <span>theme:</span>
  {/* 현재 값은 <html data-theme>를 보고 CSS가 하나만 보여 준다 (JS가 늦어도 라벨이 깜빡이지 않는다) */}
  <span class="values" aria-live="polite">
    <span class="value" data-value="light">light</span>
    <span class="value" data-value="dark">dark</span>
  </span>
</button>

<script>
  import '@/scripts/theme-toggle.ts';
</script>

<style>
  .theme-toggle {
    display: none;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    padding: 0 var(--space-2);
    /* 글자의 오른쪽 끝이 .page의 오른쪽 선과 맞도록 패딩만큼 당긴다 */
    margin-inline-end: calc(var(--space-2) * -1);
    border: 0;
    background: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: var(--fs-s);
    line-height: var(--lh-s);
    cursor: pointer;
    transition: color var(--duration) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* 데스크톱(≥641px)에서는 desktop 쪽만 보인다 */
  .theme-toggle[data-placement='desktop'] {
    display: inline-flex;
  }

  /* 모바일(≤640px)에서는 mobile 쪽만 보인다 */
  @media (max-width: 640px) {
    .theme-toggle[data-placement='mobile'] {
      display: inline-flex;
    }

    .theme-toggle[data-placement='desktop'] {
      display: none;
    }
  }

  .value {
    display: none;
  }

  /* data-theme이 없거나 dark면 dark를 보여 준다 */
  :global(:root:not([data-theme='light'])) .value[data-value='dark'],
  :global(:root[data-theme='light']) .value[data-value='light'] {
    display: inline;
  }

  /* JS가 없으면 data-theme이 지정되지 않는다. 눌러도 동작하지 않는 버튼은 숨긴다 (dark로 보인다) */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
</style>
