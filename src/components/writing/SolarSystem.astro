---
// WRITING 입구: 별 위에 떠 있는 3D 태양계. 글의 형식 4종이 누를 수 있는 천체(시=수성, 산문=목성, 에세이=토성, 책갈피=달)이고,
// 누르면 그 천체로 다가간 뒤 /writing/<form>/ 로 간다. 장면은 src/scripts/writing-system.ts(three.js)가 그리고, 아래 링크는 그 위치를 따라다니는 평범한 <a>다.
// 링크 목록이라 스크립트·WebGL이 없어도 쓸 수 있다(no-gl이면 가운데에 줄지어 선다). 이름 '우주'에서 착안(2026-10-12 사용자 지시).
import '@/styles/writing.css';
import { forms } from '@/data/writing-forms';

interface Props {
  counts: Record<string, number>;
}
const { counts } = Astro.props;
---

<section class="wspace wsystem" data-wspace="system" aria-label="Writing">
  <canvas class="wsky" data-wsky aria-hidden="true"></canvas>
  <canvas class="wgl" data-wgl aria-hidden="true"></canvas>
  <h1 class="sr-only">Writing</h1>
  <nav class="wplanets" aria-label="글의 형식">
    <ul>
      {
        forms.map((f) => (
          <li>
            <a class="pl" data-body={f.body} href={`/writing/${f.id}/`} style={`--h:${f.hue};--s:${f.sat}%;--l:${f.light}%`}>
              <span class="pl-label">
                <span class="pl-name">{f.label}</span>
                <span class="pl-meta">
                  {f.en} · {counts[f.id] ?? 0}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<script>
  import '@/scripts/writing-system';
</script>
