---
// 모든 페이지의 공통 틀: <html>, <head>, skip link, header / main / footer.
// 콘텐츠 조회는 하지 않는다 (docs/05_folder_structure.md 4.2절).
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/base.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = site.defaultLang } = Astro.props;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* 직전 페이지에서 탭 바가 벌어진 채 이동했으면 같은 모양으로 시작하고, 탭 바 빛의 시계를 이어 준다 (nav.ts, nav.css 참고). 반드시 인라인 */}
    <script is:inline>
      // 탭 바의 움직이는 빛(주기 5·8·9·12초)이 페이지를 옮겨도 이어지게 공통 시계를 준다(360초 = 네 주기의 최소공배수)
      document.documentElement.style.setProperty('--nav-clock', ((Date.now() / 1000) % 360).toFixed(3));
      try {
        if (sessionStorage.getItem('nav-open')) {
          sessionStorage.removeItem('nav-open');
          document.documentElement.setAttribute('data-nav-open', '');
        }
      } catch (e) {}
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header name={site.name} items={site.nav} currentPath={Astro.url.pathname} />
    {/* .page: header / footer와 같은 컨테이너라서 왼쪽 선이 맞는다. tabindex=-1: skip link 이동 후 포커스를 받는다 */}
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>
    <Footer name={site.name} links={site.links} />
  </body>
</html>
