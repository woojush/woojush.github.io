---
// KNOWLEDGE 첫 화면: 별이 가득한 화면 위로 분야들이 이름과 글 수만 달고 떠다닌다. 누르면 그 분야의 하위 주제가 떠다니는 화면으로, 더 누르면 끝에서 글 목록이 나온다.
// 분야는 글의 topic 경로에서 자동으로 생기고, 글이 없는 분야는 나타나지 않는다. 이름·순서·색은 src/data/topics.yaml, 가공은 lib/topics.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopicSpace from '@/components/knowledge/TopicSpace.astro';
import { getEntries, getTopicsConfig } from '@/lib/content';
import { validateLinks } from '@/lib/links';
import { buildTopicTree, stageData } from '@/lib/topics';

await validateLinks();
const entries = await getEntries('knowledge');
const config = await getTopicsConfig();
const tree = buildTopicTree(entries, config.topics);
---

<BaseLayout title="Knowledge" description="배운 것을 개념 단위로 쌓은 노트의 분야별 목록">
  {/* 홈의 흰 세계에서 효과(home-exit.ts)로 들어왔는지 첫 페인트 전에 정한다: 맞으면 흰 화면으로 시작한다(topic-space.css의 data-arrive 규칙, topic-stage.ts가 걷어낸다).
      표시는 읽는 즉시 지우고, 12초가 지난 것은 무시한다. 반드시 <head>의 인라인. */}
  <script is:inline slot="head">
    (() => {
      try {
        const at = Number(sessionStorage.getItem('world-exit'));
        sessionStorage.removeItem('world-exit');
        if (at > 0 && Date.now() - at < 12000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.arrive = 'world';
        }
      } catch (e) {}
    })();
  </script>
  {
    tree.length > 0 ? (
      <TopicSpace tree={stageData(tree)} path="" title="Knowledge" note={config.lead} chips={[]} total={0} />
    ) : (
      <>
        <h1>Knowledge</h1>
        {config.lead && <p>{config.lead}</p>}
      </>
    )
  }
</BaseLayout>
