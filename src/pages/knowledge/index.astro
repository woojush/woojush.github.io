---
// KNOWLEDGE 목록. topic 경로에서 트리를 자동으로 만든다 (docs/01 §4.3). 글이 없는 topic은 나타나지 않는다.
// 소개 문구와 topic 표시 이름·순서는 src/data/topics.yaml. 데이터 가공은 lib/topics.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopicTree from '@/components/knowledge/TopicTree.astro';
import EntryRow from '@/components/knowledge/EntryRow.astro';
import { getEntries, getTopicsConfig } from '@/lib/content';
import { validateLinks } from '@/lib/links';
import { STATUS_ORDER, buildTopicTree, countByStatus, recentlyUpdated } from '@/lib/topics';

await validateLinks();
const entries = await getEntries('knowledge');
const config = await getTopicsConfig();
const tree = buildTopicTree(entries, config.topics);
const counts = countByStatus(entries);
const recent = entries.length >= 6 ? recentlyUpdated(entries, 5) : [];
---

<BaseLayout title="Knowledge" description="배운 것을 개념 단위로 쌓은 노트의 주제별 목록">
  <h1>Knowledge</h1>
  {config.lead && <p class="lead">{config.lead}</p>}

  {
    entries.length > 0 && (
      <>
        <p class="stats">
          {entries.length}개의 노트 · {STATUS_ORDER.filter((s) => counts[s] > 0).map((s) => `${s} ${counts[s]}`).join(' · ')}
        </p>
        <p class="legend">seed는 막 적은 노트, growing은 고쳐 가는 중, evergreen은 오래 두고 볼 정리입니다.</p>

        {tree.length >= 3 && (
          <nav class="jump" aria-label="Topics">
            <ul>
              {tree.map((field) => (
                <li>
                  <a href={`#${field.anchor}`}>{field.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {recent.length > 0 && (
          <section class="recent" aria-labelledby="recent">
            <h2 id="recent">Recently updated</h2>
            <ul>
              {recent.map((n) => (
                <EntryRow href={`/knowledge/${n.id}/`} title={n.data.title} status={n.data.status} date={n.data.updated ?? n.data.date} />
              ))}
            </ul>
          </section>
        )}

        <TopicTree tree={tree} />
      </>
    )
  }
</BaseLayout>

<style>
  .lead {
    margin-bottom: var(--space-4);
    font-size: var(--fs-m);
    line-height: var(--lh-m);
  }

  .stats,
  .legend {
    margin-bottom: var(--space-1);
    color: var(--text-muted);
    font-size: var(--fs-s);
    line-height: var(--lh-s);
  }

  .legend {
    margin-bottom: var(--space-5);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
  }

  .recent {
    margin-top: var(--space-6);
  }

  .recent h2 {
    margin-top: 0;
    font-size: var(--fs-l);
    line-height: var(--lh-l);
  }

  .recent ul {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }
</style>
