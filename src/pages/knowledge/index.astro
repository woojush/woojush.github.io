---
// KNOWLEDGE 첫 화면: 분야(AI, …)만 크게 보여 준다. 분야를 누르면 세부분야, 세부분야를 누르면 그제서야 글 목록이다.
// 분야는 글의 topic 경로에서 자동으로 생기고, 글이 없는 분야는 나타나지 않는다. 이름·설명·순서는 src/data/topics.yaml, 가공은 lib/topics.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopicRow from '@/components/knowledge/TopicRow.astro';
import { getEntries, getTopicsConfig } from '@/lib/content';
import { validateLinks } from '@/lib/links';
import { buildTopicTree, topicHref } from '@/lib/topics';

await validateLinks();
const entries = await getEntries('knowledge');
const config = await getTopicsConfig();
const tree = buildTopicTree(entries, config.topics);
---

<BaseLayout title="Knowledge" description="배운 것을 개념 단위로 쌓은 노트의 분야별 목록">
  <h1>Knowledge</h1>
  {config.lead && <p class="lead">{config.lead}</p>}

  {
    tree.length > 0 && (
      <ul class="fields">
        {tree.map((field) => (
          <TopicRow
            href={topicHref(field.path)}
            name={field.name}
            count={field.count}
            description={field.description}
            meta={field.children.map((c) => c.name).join(' · ')}
          />
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .lead {
    margin-bottom: var(--space-6);
    font-size: var(--fs-m);
    line-height: var(--lh-m);
  }

  .fields {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
    border-bottom: 1px solid var(--rule);
  }
</style>
