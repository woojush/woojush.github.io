---
// 주제 페이지 하나. 분야면 세부분야 목록, 세부분야면 글 목록(묶음이 있으면 소제목으로 나눈다).
// 주소는 /knowledge/topics/<경로>/ — 글의 주소(/knowledge/<slug>/)와 무관하다 (CLAUDE.md §3-2).
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopicRow from '@/components/knowledge/TopicRow.astro';
import EntryRow from '@/components/knowledge/EntryRow.astro';
import { getEntries, getTopicsConfig } from '@/lib/content';
import { validateLinks } from '@/lib/links';
import { STATUS_ORDER, buildTopicTree, countByStatus, topicHref, type TopicNode } from '@/lib/topics';

export async function getStaticPaths() {
  const entries = await getEntries('knowledge');
  const config = await getTopicsConfig();
  const tree = buildTopicTree(entries, config.topics);
  return tree.flatMap((field) => [
    { params: { path: field.path }, props: { node: field, parent: undefined } },
    ...field.children.map((sub) => ({ params: { path: sub.path }, props: { node: sub, parent: field } })),
  ]) satisfies { params: { path: string }; props: { node: TopicNode; parent?: TopicNode } }[];
}

await validateLinks();
const { node, parent } = Astro.props as { node: TopicNode; parent?: TopicNode };
const isField = parent === undefined;
const counts = countByStatus(node.notes);
const href = (id: string) => `/knowledge/${id}/`;
const lists = node.groups.length > 0 ? node.groups : [{ path: node.path, name: '', notes: node.notes }];
---

<BaseLayout title={node.name} description={node.description ?? `${node.name} 노트 목록`}>
  <nav class="crumbs" aria-label="Topic">
    <a href="/knowledge/">Knowledge</a>
    {
      parent && (
        <>
          <span aria-hidden="true">/</span>
          <a href={topicHref(parent.path)}>{parent.name}</a>
        </>
      )
    }
  </nav>
  <h1>{node.name}</h1>
  {node.description && <p class="lead">{node.description}</p>}

  {
    isField ? (
      <>
        {node.children.length > 0 && (
          <ul class="rows">
            {node.children.map((sub) => (
              <TopicRow href={topicHref(sub.path)} name={sub.name} count={sub.count} description={sub.description} meta={sub.groups.map((g) => g.name).join(' · ')} />
            ))}
          </ul>
        )}
        {node.notes.length > 0 && (
          <ul class="rows notes">
            {node.notes.map((n) => (
              <EntryRow href={href(n.id)} title={n.data.title} status={n.data.status} date={n.data.updated ?? n.data.date} description={n.data.description} />
            ))}
          </ul>
        )}
      </>
    ) : (
      <>
        <p class="stats">
          {node.count}개의 노트 · {STATUS_ORDER.filter((s) => counts[s] > 0).map((s) => `${s} ${counts[s]}`).join(' · ')}
        </p>
        <p class="legend">seed는 막 적은 노트, growing은 고쳐 가는 중, evergreen은 오래 두고 볼 정리입니다.</p>
        {lists.map((g) => (
          <section class="group">
            {g.name && <h2>{g.name}</h2>}
            <ul class="rows notes">
              {g.notes.map((n) => (
                <EntryRow href={href(n.id)} title={n.data.title} status={n.data.status} date={n.data.updated ?? n.data.date} description={n.data.description} />
              ))}
            </ul>
          </section>
        ))}
      </>
    )
  }
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    font-size: var(--fs-s);
    line-height: var(--lh-s);
  }

  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .lead {
    margin-bottom: var(--space-5);
    font-size: var(--fs-m);
    line-height: var(--lh-m);
  }

  .stats,
  .legend {
    margin-bottom: var(--space-1);
    color: var(--text-muted);
    font-size: var(--fs-s);
    line-height: var(--lh-s);
  }

  .legend {
    margin-bottom: var(--space-5);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
    border-bottom: 1px solid var(--rule);
  }

  .group {
    margin-top: var(--space-6);
  }

  .group h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-l);
    line-height: var(--lh-l);
  }

  .notes {
    margin-bottom: var(--space-4);
  }
</style>
