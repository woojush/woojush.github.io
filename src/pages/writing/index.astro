---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntries } from '@/lib/content';

const entries = await getEntries('writing');
---

<BaseLayout title="Writing">
  <h1>Writing</h1>
  {entries.length > 0 && (
    <ul>
      {entries.map((entry) => (
        <li>
          <a href={`/writing/${entry.id}/`}>{entry.data.title}</a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
